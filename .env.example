# Copy to .env and fill in before running `docker compose up --build`.
POSTGRES_PASSWORD=change-me
# Leave empty for a phone-only setup (the Android app sends no browser Origin header).
ALLOWED_ORIGINS=
# Host-side port the API is published on (container always listens on 8080 internally).
HOST_PORT=8081
# Optional: restrict the published port to your Tailscale interface instead of every
# interface. Run `tailscale ip -4` on this server and paste the result here. Leave blank
# to bind all interfaces (fine if this host has no other network exposure).
TAILSCALE_IP=
